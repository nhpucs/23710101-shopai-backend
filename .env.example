

# Cổng Server lắng nghe. Nhớ dùng cùng cổng này ở Mobile.
PORT=3000

# API Key của Google Gemini — lấy tại https://aistudio.google.com/app/apikey
# Viết liền sau dấu "=", KHÔNG nháy, KHÔNG chấm phẩy.
GEMINI_API_KEY=

# Chuỗi bí mật ký JWT (AuthModule – Bước 7e). Dùng chuỗi ngẫu nhiên dài.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Database Prisma (Bước 7d). SQLite = một file trong thư mục prisma/.
DATABASE_URL="file:./dev.db"
